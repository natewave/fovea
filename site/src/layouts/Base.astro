---
import "../../../ports/palette/fovea.css";
import "@fontsource/atkinson-hyperlegible-next/latin-400.css";
import "@fontsource/atkinson-hyperlegible-next/latin-700.css";
import "@fontsource/atkinson-hyperlegible-mono/latin-400.css";
import "@fontsource/atkinson-hyperlegible-mono/latin-700.css";
import "../styles/global.css";
import proseFont from "@fontsource/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-400-normal.woff2?url";
import { palette, role } from "@fovea/palette";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { url } from "../lib/paths.ts";

interface Props {
  readonly title: string;
  readonly description: string;
}

const { title, description } = Astro.props;
const fullTitle =
  title === "" ? "Fovea: a color scheme informed by vision research" : `${title} · Fovea`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url("og.png"), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("fovea-theme");
        if (saved === "day" || saved === "dusk" || saved === "night") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={role(palette.day, "surface.chrome")} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={role(palette.dusk, "surface.chrome")} />
    <link rel="preload" href={proseFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fovea" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Fovea logo, a ring around a central pit, beside the palette's colors." />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div id="announcer" class="visually-hidden" aria-live="polite"></div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    background: var(--fovea-surface-popup);
    color: var(--fovea-link);
    border: 2px solid var(--fovea-focus);
    border-radius: 8px;
    font-weight: 700;
  }

  .skip-link:focus {
    top: 1rem;
  }

  main:focus {
    outline: none;
  }
</style>
